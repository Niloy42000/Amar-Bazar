rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // Firebase Authentication থেকে আপনার Admin user UID এখানে বসান।
      return request.auth != null && request.auth.uid == "PASTE_ADMIN_UID_HERE";
    }

    match /orders/{orderId} {
      // গ্রাহক অর্ডার জমা দিতে পারবে, কিন্তু অর্ডার পড়তে পারবে না।
      allow create: if
        request.resource.data.keys().hasAll([
          'customerName','phone','address','area','notes','items',
          'total','paymentMethod','status','createdAt'
        ]) &&
        request.resource.data.customerName is string &&
        request.resource.data.customerName.size() > 0 &&
        request.resource.data.customerName.size() <= 100 &&
        request.resource.data.phone is string &&
        request.resource.data.phone.size() >= 8 &&
        request.resource.data.phone.size() <= 20 &&
        request.resource.data.address is string &&
        request.resource.data.address.size() > 0 &&
        request.resource.data.address.size() <= 500 &&
        request.resource.data.items is list &&
        request.resource.data.items.size() > 0 &&
        request.resource.data.items.size() <= 50 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.paymentMethod == 'Cash on Delivery' &&
        request.resource.data.status == 'নতুন';
      allow read, update, delete: if isAdmin();
    }
  }
}